# Backend / combined production supervisor. Never commit the real .env.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; keep this key with your database backups.
ENCRYPTION_KEY=
BACKEND_PORT=3001
BACKEND_URL=http://127.0.0.1:3001
FRONTEND_URL=http://127.0.0.1:3000
DASHBOARD_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# Optional provider credentials. Configure only providers you use.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
JINA_API_KEY=
TOGETHER_API_KEY=
NVIDIA_API_KEY=
ELEVENLABS_API_KEY=
POLLINATIONS_API_KEY=

# Public Supabase configuration (also required at frontend build time).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
