# Backend / combined production supervisor. Never commit the real .env.
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production; keep this key with your database backups.
ENCRYPTION_KEY=
# Required for production. Generate a DIFFERENT random value for each secret.
# The first browser prompt is this private deployment account; Supabase sign-in follows.
VOID_ACCESS_USER=
VOID_ACCESS_PASSWORD=
VOID_INTERNAL_KEY=
# Optional HTTPS Compose overlay. DNS A/AAAA must point to your Docker server.
VOID_DOMAIN=
# Public frontend port. Hosting platforms can override PORT at runtime.
PORT=3000
BACKEND_PORT=3001
BACKEND_URL=http://127.0.0.1:3001
FRONTEND_URL=http://127.0.0.1:3000
VOID_ALLOWED_ORIGINS=http://localhost:3000

# Server search integrations. Tavily is the primary search/image source.
TAVILY_API_KEY=
# Optional search fallback and authenticated page extraction.
BRAVE_API_KEY=
JINA_API_KEY=

# Optional managed chat / image credentials. Leave unused providers blank.
# Ordinary users connect their own encrypted keys in Settings > AI Providers.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
TOGETHER_API_KEY=
NVIDIA_API_KEY=
POLLINATIONS_API_KEY=
# Optional image workers; configure only the worker you deploy/use.
CLOUDFLARE_SDXL_URL=
CLOUDFLARE_SDXL_KEY=
IMG2IMG_WORKER_URL=
IMG2IMG_WORKER_KEY=

# Public Supabase configuration (also required at frontend build time).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase service role key for encrypted user provider records.
SUPABASE_SERVICE_ROLE_KEY=

# For separate hosts only: browser-reachable WSS URL, never the internal backend address.
# Combined HTTPS Compose uses the public app origin automatically.
VOICE_PUBLIC_WS_URL=
# Server-side role and managed-resource policy. Admins can also be assigned app_metadata.role=admin.
VOID_ADMIN_USER_IDS=
# Chat keys are required for ordinary accounts; only admins use managed chat.
VOID_ALLOW_FREE_IMAGE=false
VOID_ALLOW_FREE_VOICE=false
VOID_MANAGED_GROQ_MODEL=openai/gpt-oss-120b
VOID_MANAGED_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# Browser/server voice uses connected user credentials, not server voice API keys.
# The standalone desktop-agent has its own .env.example.
