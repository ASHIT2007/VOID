# Copy to frontend/.env.local for local development.
# Public values are embedded at build time. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never use NEXT_PUBLIC_ for these values. Share ENCRYPTION_KEY with the backend.
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
BACKEND_URL=http://127.0.0.1:3001
VOID_ACCESS_USER=
VOID_ACCESS_PASSWORD=
VOID_INTERNAL_KEY=
# Leave ALL three access values unset for local development without the private access prompt.
# Production requires a password >=24 chars and an internal key >=32 chars.
VOICE_PUBLIC_WS_URL=
# Server-side role and managed-resource policy. Admins can also be assigned app_metadata.role=admin.
VOID_ADMIN_USER_IDS=
# Chat keys are required for ordinary accounts; only admins use managed chat.
VOID_ALLOW_FREE_IMAGE=false
VOID_ALLOW_FREE_VOICE=false
VOID_MANAGED_GROQ_MODEL=openai/gpt-oss-120b

# Optional managed credentials used by Next.js API routes.
# User provider/voice credentials belong in Settings > AI Providers.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
TOGETHER_API_KEY=
NVIDIA_API_KEY=
POLLINATIONS_API_KEY=
IMG2IMG_WORKER_URL=
IMG2IMG_WORKER_KEY=
CLOUDFLARE_SDXL_URL=
CLOUDFLARE_SDXL_KEY=
