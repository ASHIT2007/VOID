# Copy to frontend/.env.local for local development.
# Public values are embedded at build time. Never put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
BACKEND_URL=http://127.0.0.1:3001

# Optional server-only credentials used by Next.js API routes.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
TOGETHER_API_KEY=
POLLINATIONS_API_KEY=
IMG2IMG_WORKER_URL=
IMG2IMG_WORKER_KEY=
CLOUDFLARE_SDXL_URL=
CLOUDFLARE_SDXL_KEY=
